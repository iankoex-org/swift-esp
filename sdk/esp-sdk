#!/bin/sh
# Launcher for the host-only Swift tooling in sdk/tooling/.
#
# The tooling builds for the host (never for the ESP target) and is kept out
# of the root package so it does not enter application dependency graphs.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$ROOT"
# SwiftPM derives its toolchain bin dir from argv[0] relative to cwd. A
# PATH-invoked "swift" plus --package-path can therefore look for
# <package>/swiftc. Resolve both absolutely and pin the bin dir.
#
# Swift 6.4's default Swift Build backend still cannot locate swiftc when the
# toolchain is installed as <root>/bin instead of <root>/usr/bin, so force the
# native backend for the host-tooling build.
SWIFT_BIN=$(command -v swift)
SWIFTC_BIN=""
if command -v swiftly >/dev/null 2>&1; then
  SWIFTC_BIN=$(swiftly run which swiftc 2>/dev/null || true)
fi
if [ -z "$SWIFTC_BIN" ]; then
  SWIFTC_BIN=$(command -v swiftc)
fi
SWIFTPM_CUSTOM_BIN_DIR=$(dirname "$SWIFTC_BIN")
export SWIFTPM_CUSTOM_BIN_DIR
exec "$SWIFT_BIN" run --package-path "$ROOT/sdk/tooling" -c release --build-system native esp-sdk "$@"
